# AI Recruiter - Environment Variables
# Copy this to services/.env and fill in your values

# ============================================
# LLM Configuration
# ============================================
# Shared API key used by backend + worker for all LLM calls
LLM_API_KEY="YOUR_LLM_API_KEY_HERE"

# ============================================
# Authentication
# ============================================
# Secret for signing JWT tokens (generate with: openssl rand -hex 32)
JWT_SECRET="CHANGE_ME_TO_RANDOM_64_CHAR_STRING"

# ============================================
# PostgreSQL (Supabase or Neon)
# ============================================
DATABASE_CONNECTION_STRING="postgresql+asyncpg://user:password@host:5432/dbname"

# ============================================
# Redis (Upstash) -- OTP, sessions, job queue
# ============================================
UPSTASH_REDIS_REST_URL="https:xxxx"
UPSTASH_REDIS_REST_TOKEN="xxxxx"

# ============================================
# Email (Resend)
# ============================================
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# ============================================
# GitHub (optional)
# ============================================
GITHUB_TOKEN=""
